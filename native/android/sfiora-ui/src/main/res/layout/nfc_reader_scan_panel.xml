<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/nfc_reader_scan_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/nfc_reader_panel_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/nfc_reader_scan_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif"
                android:gravity="bottom|center_horizontal"
                android:includeFontPadding="false"
                android:text="@string/nfc_reader_scan_title"
                android:textColor="@color/nfc_reader_on_surface"
                android:textSize="26sp"
                android:textStyle="bold"
                android:translationY="2dp" />

            <ImageButton
                android:id="@+id/nfc_reader_scan_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/nfc_reader_close_background"
                android:contentDescription="@string/nfc_reader_scan_cancel"
                android:elevation="0dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/nfc_reader_ic_close" />

        </FrameLayout>

        <TextView
            android:id="@+id/nfc_reader_scan_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:maxWidth="300dp"
            android:minLines="2"
            android:text="@string/nfc_reader_scan_instruction"
            android:textColor="@color/nfc_reader_on_surface_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.sandrox.sfiora.ui.NfcReaderScanAnimationView
                android:id="@+id/nfc_reader_scan_animation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/nfc_reader_scan_status_icon"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/nfc_reader_ic_success"
                android:visibility="invisible" />

        </FrameLayout>

        <Button
            android:id="@+id/nfc_reader_scan_cancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="27dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/nfc_reader_cancel_background"
            android:elevation="0dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:minHeight="48dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/nfc_reader_scan_cancel"
            android:textAllCaps="false"
            android:textColor="@color/nfc_reader_control_text"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
