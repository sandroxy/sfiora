{
  "schemaVersion": 1,
  "id": "sfiora",
  "displayName": "Sfiora",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": "https://github.com/sandroxy/sfiora.git",
  "adapters": {
    "reactNative": {
      "package": "@sandrox/sfiora",
      "minimumVersion": "0.76"
    },
    "uniApp": {
      "kind": "nativeplugin",
      "id": "Sandrox-Sfiora",
      "module": "Sfiora",
      "minimumHBuilderX": "5.24"
    },
    "uniAppUts": {
      "kind": "uts",
      "id": "Sandrox-Sfiora",
      "sourceRoot": "uni_modules/Sandrox-Sfiora",
      "minimumHBuilderX": "5.24",
      "runtimes": [
        "uni-app",
        "uni-app-x"
      ]
    }
  },
  "native": {
    "android": {
      "group": "io.github.sandroxy",
      "artifacts": [
        "sfiora",
        "sfiora-ui"
      ],
      "minimumSdk": 21
    },
    "ios": {
      "distribution": "binarySwiftPackage",
      "module": "Sfiora",
      "minimumVersion": "13.0"
    }
  }
}
