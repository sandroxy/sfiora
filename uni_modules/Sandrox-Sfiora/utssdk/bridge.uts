import { InvokeSfioraNative } from './interface.uts'

// UTS Error.code is numeric on iOS; preserve our string code in a Promise rejection value.
export class SfioraError {
  name: string = 'SfioraError'
  code: string = 'INTERNAL_ERROR'
  message: string = 'The NFC operation failed'
  recoverable: boolean = false
  nativeError: UTSJSONObject | null = null

  constructor(payload: UTSJSONObject) {
    this.code = payload.getString('code') ?? 'INTERNAL_ERROR'
    this.message = payload.getString('message') ?? 'The NFC operation failed'
    this.recoverable = payload.getBoolean('recoverable') ?? false
    this.nativeError = payload.getJSON('nativeError')
  }
}

function invalidResponse(): SfioraError {
  return new SfioraError({
    code: 'INTERNAL_ERROR', message: 'The native NFC bridge returned an invalid response', recoverable: false,
  })
}

function invoke(transport: InvokeSfioraNative, method: string, args: UTSJSONObject[]): Promise<UTSJSONObject> {
  return new Promise<UTSJSONObject>((resolve, reject) => {
    const json = JSON.stringify(args)
    if (json == null) {
      reject(new SfioraError({ code: 'INVALID_OPTIONS', message: 'NFC arguments must be JSON values', recoverable: true }))
      return
    }
    transport(method, json!, (resultJson: string) => {
      const result = JSON.parseObject(resultJson)
      if (result == null) {
        reject(invalidResponse())
        return
      }
      const response = result!
      if (response.getBoolean('ok') == true) {
        resolve(response)
        return
      }
      const error = response.getJSON('error')
      reject(error == null ? invalidResponse() : new SfioraError(error!))
    })
  })
}

export function invokeObject(transport: InvokeSfioraNative, method: string, args: UTSJSONObject[]): Promise<UTSJSONObject> {
  return invoke(transport, method, args).then((envelope: UTSJSONObject): Promise<UTSJSONObject> => {
    return new Promise<UTSJSONObject>((resolve, reject) => {
      const data = envelope.getJSON('data')
      if (data == null) {
        reject(invalidResponse())
        return
      }
      resolve(data!)
    })
  })
}

export function invokeBoolean(transport: InvokeSfioraNative, method: string): Promise<boolean> {
  return invoke(transport, method, []).then((envelope: UTSJSONObject): Promise<boolean> => {
    return new Promise<boolean>((resolve, reject) => {
      const data = envelope.getBoolean('data')
      if (data == null) {
        reject(invalidResponse())
        return
      }
      resolve(data!)
    })
  })
}

export function invokeVoid(transport: InvokeSfioraNative, method: string): Promise<void> {
  return invoke(transport, method, []).then((_envelope: UTSJSONObject): void => {})
}
